# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Expo web bundle copied into Next public/ during site build (regenerated on deploy)
site/public/app/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env.vercel.*

# local E2E / test artifacts (may contain credentials)
test_accounts.txt
test_dating_photo.png
test_review_video.mp4

# supabase CLI temp
supabase/.temp/

# typescript
*.tsbuildinfo

# Next.js build output (never commit)
site/.next/
.vercel
